  "vin": "VIN-999",
  "brand": "Ford",
  "model": "Focus ST",
  "fuel": "PETROL",
  "transmission": "MANUAL",
  "status": "AVAILABLE",
  "dailyRate": 150.00
}


### 2.6 ADMIN (bob) – usunięcie pojazdu VIN-999
DELETE http://localhost:9080/car-rental-1.0-SNAPSHOT/api/vehicles/VIN-101
Accept: application/json
Authorization: Basic Ym9iOmJvYjEyMw==


### 3.1 ADMIN (bob) – pobranie wszystkich rentalów dla VIN-101
GET http://localhost:9080/car-rental-1.0-SNAPSHOT/api/vehicles/VIN-103/rentals
Accept: application/json
Authorization: Basic Ym9iOmJvYjEyMw==

### 3.2 USER (alice) – pobranie rentalów dla VIN-101
GET http://localhost:9080/car-rental-1.0-SNAPSHOT/api/vehicles/VIN-103/rentals
Accept: application/json
Authorization: Basic YWxpY2U6YWxpY2UxMjM=

### 3.3 USER (charlie) – brak wypożyczeń dla VIN-101 (powinna być pusta lista)
GET http://localhost:9080/car-rental-1.0-SNAPSHOT/api/vehicles/VIN-101/rentals
Accept: application/json
Authorization: Basic Y2hhcmxpZTpjaGFybGllMTIz

### 3.4 USER (alice) – pobranie pojedynczego wypożyczenia VIN-101 / {{ALICE_RENTAL_ID}}
GET http://localhost:9080/car-rental-1.0-SNAPSHOT/api/vehicles/VIN-101/rentals/{{ALICE_RENTAL_ID}}
Accept: application/json
Authorization: Basic YWxpY2U6YWxpY2UxMjM=   # alice:alice123

### 3.5 USER (charlie) – próba podejrzenia cudzego rentalu (powinno zwrócić 404)
GET http://localhost:9080/car-rental-1.0-SNAPSHOT/api/vehicles/VIN-101/rentals/{{ALICE_RENTAL_ID}}
Accept: application/json
Authorization: Basic Y2hhcmxpZTpjaGFybGllMTIz   # charlie:charlie123

### 3.6 USER (alice) – stworzenie nowego wypożyczenia dla VIN-102
POST http://localhost:9080/car-rental-1.0-SNAPSHOT/api/vehicles/VIN-102/rentals
Content-Type: application/json
Accept: application/json
Authorization: Basic YWxpY2U6YWxpY2UxMjM=   # alice:alice123

{
  "startAt": "2025-11-21T10:00:00",
  "endAt": "2025-11-23T10:00:00",
  "status": "CREATED",
  "price": 600.00
}

